# Shandong platform local development environment.
# Copy to .env for local use only. Do not commit real production values.

SHANDONG_AUTH_MODE=local
SHANDONG_REQUIRE_AUTH=false
SHANDONG_ALLOW_LOCAL_ADMIN_FALLBACK=true
SHANDONG_DATABASE_URL=sqlite:///data/shandong_v2.db
SHANDONG_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
SHANDONG_SESSION_TTL_MINUTES=240
SHANDONG_USE_DATABASE_STORAGE=true
SHANDONG_DB_ECHO=false
SHANDONG_LOG_LEVEL=INFO

# Production operators must set secure values outside git:
# - use SHANDONG_AUTH_MODE=production
# - require auth
# - disable local admin fallback
# - provide secrets through the deployment platform, never this file
