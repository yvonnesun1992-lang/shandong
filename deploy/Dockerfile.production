FROM node:22-slim AS frontend
WORKDIR /frontend
COPY web/frontend/package.json web/frontend/next.config.js web/frontend/tsconfig.json ./
COPY web/frontend/app ./app
COPY web/frontend/scripts ./scripts
RUN npm run build

FROM python:3.12-slim AS backend
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV SHANDONG_API_ENABLED=true
ENV SHANDONG_CACHE_ENABLED=true
ENV SHANDONG_MULTI_USER=true
ENV SHANDONG_LOG_LEVEL=INFO
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
COPY --from=frontend /frontend /app/web/frontend
EXPOSE 8000
CMD ["uvicorn", "src.api.v2.server:app", "--host", "0.0.0.0", "--port", "8000"]
